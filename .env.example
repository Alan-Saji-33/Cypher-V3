# =============================================
# Cypher v3 — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================

# Discord Bot Credentials
BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
OWNER_ID=your_owner_discord_id_here

# Channel IDs
STATS_CHANNEL_ID=your_stats_channel_id_here
ACTIVITY_CHANNEL_ID=your_activity_channel_id_here
WELCOME_CHANNEL_ID=your_welcome_channel_id_here
AFK_CHANNEL_ID=your_afk_channel_id_here

# Server / Media Config
WELCOME_IMAGE_URL=https://i.ibb.co/JFtcX23r/standard-3.gif
SERVER_BANNER_URL=https://i.ibb.co/whj6yh7Q/IMG-20250726-122907.png

# Web Server
PORT=3000
